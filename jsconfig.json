{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src-tauri/src/scripts/**/*.js"],
  "exclude": [
    "src-tauri/src/scripts/core.js",
    "node_modules",
    "dist",
    "target",
    "**/*.mjs"
  ]
}
